#!/usr/bin/env bash
# kil: filter processes in real time with fzf, then send a signal (SIGKILL by
# default) to the selected lines (Tab to select, Ctrl-A to select every line
# shown) by pressing Enter.
# If nothing is selected, Enter signals the line under the cursor.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: kil [--] [query...]

Filter processes interactively with fzf and send a signal to the selected ones.
All arguments are joined with spaces into the initial fzf query.

Options:
  -h, --help   Show this help and exit
  --           Treat the remaining arguments as the query (e.g. kil -- -zsh)

Environment:
  KIL_SIGNAL   Signal number or name to send (default: 9, i.e. SIGKILL)

Exit status:
  0    every selected process was signalled
  1    nothing was selected, or some processes were skipped or failed
  2    usage error, invalid KIL_SIGNAL, listing processes failed, or fzf failed
  130  aborted with Ctrl-C / Esc
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -?*)
      echo "kil: unknown option: $1 (use 'kil -- $1' to search for it)" >&2
      usage >&2
      exit 2
      ;;
    *) break ;;
  esac
done
QUERY="$*"

if ! command -v fzf >/dev/null 2>&1; then
  echo "kil: fzf not found (install it, e.g. brew install fzf)" >&2
  exit 2
fi

SIGNAL="${KIL_SIGNAL:-9}"
invalid_signal() {
  echo "kil: invalid KIL_SIGNAL: '$SIGNAL' (use a number like 15 or a name like TERM)" >&2
  exit 2
}
# Reject a leading "-" before asking `kill -l`, which would otherwise parse it
# as an option (e.g. "-9" makes it list every signal and succeed), and so would
# `kill` itself later.
if ! [[ "$SIGNAL" =~ ^[A-Za-z0-9][A-Za-z0-9+-]*$ ]] || ! kill -l "$SIGNAL" >/dev/null 2>&1; then
  invalid_signal
fi
if [[ "$SIGNAL" =~ ^[0-9]+$ ]]; then
  signum=$SIGNAL
  # `kill -l` also decodes exit statuses (137 -> KILL), which `kill -s`
  # then rejects, so require the number to round-trip through its name.
  [ "$(kill -l "$(kill -l "$signum")")" = "$signum" ] || invalid_signal
else
  signum=$(kill -l "$SIGNAL")
fi
# bash numbers its trap-only pseudo-signals (DEBUG, ERR, RETURN) from NSIG
# up; `kill -l` accepts them but `kill -s` does not.
nsig=$(kill -l DEBUG 2>/dev/null || true)
if [[ "$nsig" =~ ^[0-9]+$ ]] && [ "$signum" -ge "$nsig" ]; then
  invalid_signal
fi
if [ "$signum" = 0 ]; then
  SIGNAL_LABEL="signal 0"
else
  SIGNAL_LABEL="SIG$(kill -l "$signum")"
fi

# Hide only this kil invocation and its descendants (its command-substitution
# subshell, fzf, ps/awk, and the shell fzf spawns for Ctrl-R). Matching by
# name instead would hide every fzf on the system, and would miss kil itself
# because `env bash` makes its comm "bash".
# The whole table is read before walking parents because ps does not
# guarantee parents are listed first; the step cap guards against PPID cycles
# in a snapshot taken while processes are exiting.
export KIL_SELF_PID=$$
# shellcheck disable=SC2016 # awk program; $0, $1, $2 are awk fields
export KIL_FILTER_AWK='
{ n++; line[n] = $0; pid[n] = $1; parent[$1] = $2 }
END {
  for (i = 1; i <= n; i++) {
    p = pid[i]; hide = 0
    for (steps = 0; steps < 10000 && p != 0; steps++) {
      if (p == self) { hide = 1; break }
      if (!(p in parent)) break
      p = parent[p]
    }
    if (!hide) print line[i]
  }
}'

# A failed ps means the list may be incomplete, so kil refuses to signal from
# it. fzf runs the Ctrl-R reload in /bin/sh, out of reach of this script's
# exit-status checks (and without pipefail), so both the initial list and the
# reload report a ps failure by sending SIGUSR1 to this script. A signal is
# used rather than a marker file because it cannot be lost to an unwritable
# or full disk, which would let the failure go unnoticed.
# ps cannot die of SIGPIPE here because awk reads all input before printing.
list_failed=0
trap 'list_failed=1' USR1
# A non-interactive bash cannot trap a signal that was ignored when it
# started, so if the parent ignores SIGUSR1 the trap above is silently
# inert and failures would go unnoticed. Probe it with a signal to ourselves.
kill -s USR1 "$$"
if [ "$list_failed" != 1 ]; then
  echo "kil: cannot catch SIGUSR1 (ignored by the parent process?); refusing to run" >&2
  exit 2
fi
list_failed=0

# Values are passed through the environment rather than interpolated, so the
# command needs no quoting when fzf runs it for Ctrl-R.
# shellcheck disable=SC2016 # expanded later by the shell that runs it
LIST_CMD='{ command ps -A -o pid=,ppid=,user=,comm=,args= || kill -s USR1 "$KIL_SELF_PID"; } | awk -v self="$KIL_SELF_PID" "$KIL_FILTER_AWK"'

# The user's fzf defaults are ignored on purpose: options such as --read0
# (the whole list becomes one item, so every process gets signalled),
# --filter (no Enter needed), --print-query or --accept-nth change what fzf
# prints, and kil treats that output as PIDs. SHELL is pinned so Ctrl-R does
# not depend on aliases or functions from the user's shell startup files.
run_fzf() {
  FZF_DEFAULT_OPTS='' FZF_DEFAULT_OPTS_FILE='' SHELL=/bin/sh fzf "$@"
}

# Collapse runs of whitespace so lines from `ps -A` and `ps -p` compare equal
# even if column padding differs.
normalize() {
  awk '{$1 = $1; print}'
}

# Keep multi-selections across Ctrl-R. Rows are identified by the whole line,
# not just the PID: if a selected process exits and its PID is reused before
# the reload, a PID-only identity would carry the selection over to the new
# process, and the pre-kill re-check would then pass against the new line.
# Older fzf releases reject --id-nth outright, so only enable it when supported.
RELOAD_ACTION=reload
TRACK_OPTS=()
if echo x | run_fzf --id-nth=.. --filter=x >/dev/null 2>&1; then
  RELOAD_ACTION=reload-sync
  TRACK_OPTS=(--track --id-nth=..)
fi

# fzf keeps selections that the current query hides and prints them on Enter,
# so a process selected earlier would be signalled without being on screen.
# Clearing the selection on every query change keeps Enter limited to what is
# shown. Ctrl-R does not change the query, so it keeps selections.
# fzf's status is taken from PIPESTATUS: under pipefail, the producer can die
# of SIGPIPE when fzf exits first, which would otherwise mask fzf's status.
status=0
selected=$(
  eval "$LIST_CMD" | run_fzf \
    --query="$QUERY" \
    --multi \
    ${TRACK_OPTS[@]+"${TRACK_OPTS[@]}"} \
    --header "kil: type to filter, Tab to select, Ctrl-A to select all shown, Ctrl-R to refresh, Enter to send ${SIGNAL_LABEL} to selected/current line (Ctrl-C to abort)" \
    --bind "ctrl-a:select-all" \
    --bind "change:clear-selection" \
    --bind "ctrl-r:$RELOAD_ACTION:$LIST_CMD"
  exit "${PIPESTATUS[1]}"
) || status=$?

if [ "$list_failed" = 1 ]; then
  echo "kil: failed to list processes (ps failed); nothing was signalled" >&2
  exit 2
fi

case "$status" in
  0) ;;
  1)
    echo "kil: nothing selected" >&2
    exit 1
    ;;
  130)
    echo "kil: aborted" >&2
    exit 130
    ;;
  *)
    echo "kil: fzf failed (exit status $status)" >&2
    exit 2
    ;;
esac

problems=0
while IFS= read -r line; do
  pid=$(awk '{print $1}' <<< "$line")
  # Only positive integers: 0 and negative values make kill signal whole
  # process groups (-1 means every process the user can signal).
  if ! [[ "$pid" =~ ^[1-9][0-9]*$ ]]; then
    echo "skipped: not a PID: $line" >&2
    problems=1
    continue
  fi
  # The list is a snapshot; if the process exited meanwhile, its PID may have
  # been reused by an unrelated process, so re-check it is still the same one.
  # This narrows the window but cannot close it: the PID can still change
  # between this check and the kill below.
  current=$(command ps -p "$pid" -o pid=,ppid=,user=,comm=,args= 2>/dev/null | normalize || true)
  if [ "$current" != "$(normalize <<< "$line")" ]; then
    echo "skipped: process changed or exited: $line" >&2
    problems=1
    continue
  fi
  if kill -s "$SIGNAL" -- "$pid" 2>/dev/null; then
    echo "sent ${SIGNAL_LABEL}: $line"
  else
    echo "failed: $line" >&2
    problems=1
  fi
done <<< "$selected"

exit "$problems"
